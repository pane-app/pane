+/// Redefines, as traps, the imported interfaces holding an `async func`.
+///
+/// `define_unknown_imports_as_traps` stubs every function with `func_new`,
+/// which only a sync-typed import accepts, so a component importing an
+/// `async func` the componentizer does not provide (an interface of the
+/// embedding host) could not be instantiated under Wizer. Such an interface
+/// is replaced whole: async functions with `func_new_concurrent`, others with
+/// `func_new`, resources with host resources. None of them runs while the
+/// snapshot is taken. WASI interfaces but `wasi:http` are defined next.
+fn define_unknown_async_imports_as_traps(
+    linker: &mut Linker<Ctx>,
+    engine: &Engine,
+    component: &WasmtimeComponent,
+) -> Result<()> {
+    use wasmtime::component::ResourceType;
+    use wasmtime::component::types::ComponentItem;
+
+    let ty = component.component_type();
+    for (name, item) in ty.imports(engine) {
+        let ComponentItem::ComponentInstance(instance) = item.ty else {
+            continue;
+        };
+        let has_async = instance.exports(engine).any(
+            |(_, export)| matches!(export.ty, ComponentItem::ComponentFunc(func) if func.async_()),
+        );
+        if (name.starts_with("wasi:") && !name.starts_with("wasi:http/")) || !has_async {
+            continue;
+        }
+        let mut stubs = linker.instance(name)?;
+        for (export, item) in instance.exports(engine) {
+            let unknown = format!("unknown import: `{name}#{export}` has not been defined");
+            match item.ty {
+                ComponentItem::ComponentFunc(func) if func.async_() => {
+                    stubs.func_new_concurrent(export, move |_, _, _, _| {
+                        let unknown = unknown.clone();
+                        Box::pin(async move { Err(wasmtime::Error::msg(unknown)) })
+                    })?
+                }
+                ComponentItem::ComponentFunc(_) => {
+                    stubs.func_new(export, move |_, _, _, _| Err(wasmtime::Error::msg(unknown.clone())))?
+                }
+                ComponentItem::Resource(_) => {
+                    stubs.resource(export, ResourceType::host::<()>(), |_, _| Ok(()))?
+                }
+                _ => {}
+            }
+        }
+    }
+    Ok(())
+}
