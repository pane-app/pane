// Author-side world for JS/TS Pane guests. It exports exactly Pane's contract
// (wit/extension.wit, copied into deps/ at build time) and declares the WASI 0.3
// imports the JS source may use. The host bindings are unchanged.
package pane:js-guest@0.1.0;

world js-extension {
  include pane:extension/extension@0.1.0;
  import wasi:clocks/monotonic-clock@0.3.0;
}
