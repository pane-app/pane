package pane:extension@0.1.0;

// SPDX-License-Identifier: Apache-2.0 OR MIT
//
// A command that takes a query: text the user typed into root search, which
// Pane sends to the command only when the user invokes it, through an alias
// ("ec hello" when the command's alias is "ec") or by choosing it as a
// fallback for whatever was typed. Kept apart from extension.wit so a
// command that takes none is unchanged: only a command whose `pane.json`
// entry sets `"takesQuery": true` exports this interface, beside `command`.
// Rust commands export it through pane-guest (`pane_guest::query::export!`).
// The header follows `package`: comments above it would document the package,
// which extension.wit already does.

interface query-command {
  /// Runs the command `command` (its id in `pane.json`, so one component
  /// can serve several commands that take a query) with `query`, the text
  /// the user typed into root search (after the command's alias, or all of
  /// it for a fallback), trimmed and never empty. Pane calls it only when
  /// the user invokes the command that way, never while they type. The
  /// returned text is shown to the user as the result; an error is shown as
  /// the failure.
  run-query: async func(command: string, query: string) -> result<string, string>;
}

/// The query-taking export alone: a command component that takes a query
/// exports it besides the `extension` world's `command`.
world query-command-provider {
  export query-command;
}
