package pane:extension@0.1.0;

// SPDX-License-Identifier: Apache-2.0 OR MIT
//
// A command that searches as the user types into its own search field, such
// as one searching an online service: once the user has opened the command,
// Pane sends it the text typed there and lists the items it answers with.
// Root search never asks it, so nothing typed there reaches the command or
// its service. Kept apart from extension.wit so a command that does not
// search is unchanged: only a command whose `pane.json` entry sets
// `"search": true` exports this interface, beside `command`. Rust commands
// export it through pane-guest (`pane_guest::search::export!`), JS/TS
// commands by exporting `commandSearch` with `"search": true` in their
// package.json's `"pane"` options.
//
// A command reaches a web service through `wasi:http@0.3.0`'s client
// (wit/deps/http.wit), which Pane hosts for every command; the `http-user`
// world below imports it alone for guest bindings (`pane_guest::http`).
// The header follows `package`: comments above it would document the package,
// which extension.wit already does.

interface command-search {
  /// One thing the search found, listed as a row of the command.
  record search-result {
    /// Passed to the command's `handle-event` as the callback id when the
    /// user activates the row, so it should say which result it is (the
    /// command's instance may have been replaced meanwhile).
    id: string,
    title: string,
    subtitle: option<string>,
  }

  /// Searches for `query`, the text in the search field of the command
  /// `command` (its id in `pane.json`, so one component can serve several
  /// commands), trimmed and never empty. The results replace the command's
  /// list while the text stays; activating one calls `handle-event` with
  /// its id as the callback, whose answer is shown as an item's action's
  /// is. An error is shown to the
  /// user in place of results, and does not count against the extension: a
  /// service that is down or unreachable is an expected error, not a
  /// crash.
  ///
  /// Pane asks again as the text changes, and stops a search it no longer
  /// needs (the text changed again, or the user left the command) where it
  /// waits, dropping the instance with its web requests: code after that
  /// `await` never runs, and the instance's memory is lost, so keep nothing
  /// needed later only in memory.
  search: async func(command: string, query: string) -> result<list<search-result>, string>;
}

/// The search export alone: a command component that searches as the user
/// types exports it besides the `extension` world's `command`.
world command-search-provider {
  export command-search;
}

/// `wasi:http`'s client alone, for guest bindings: Pane sends a command's web
/// requests (`http` and `https`, over HTTP/1.1, trusting the system's
/// certificates).
world http-user {
  import wasi:http/client@0.3.0;
}
