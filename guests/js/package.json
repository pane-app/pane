{
  "name": "@pane-app/extension",
  "version": "0.1.0",
  "description": "Write Pane extensions in JavaScript or TypeScript: the types of Pane's extension contract (wit/extension.wit), web requests (@pane-app/extension/http), toasts, HUDs and the window (@pane-app/extension/feedback), the clipboard, opening, revealing and recycling with the standard actions (@pane-app/extension/system), preferences (@pane-app/extension/preferences), icon helpers (@pane-app/extension/icons) and system programs (@pane-app/extension/programs)",
  "keywords": [
    "pane",
    "launcher",
    "extension",
    "wasm",
    "component-model"
  ],
  "homepage": "https://github.com/pane-app/pane/tree/main/guests/js#readme",
  "bugs": "https://github.com/pane-app/pane/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pane-app/pane.git",
    "directory": "guests/js"
  },
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "files": [
    "*.js",
    "*.d.ts",
    "schema/pane.schema.json",
    "wit/world.wit",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "types": "pane.d.ts",
  "exports": {
    ".": {
      "types": "./pane.d.ts"
    },
    "./http": {
      "types": "./http.d.ts",
      "default": "./http.js"
    },
    "./feedback": {
      "types": "./feedback.d.ts",
      "default": "./feedback.js"
    },
    "./system": {
      "types": "./system.d.ts",
      "default": "./system.js"
    },
    "./preferences": {
      "types": "./preferences.d.ts",
      "default": "./preferences.js"
    },
    "./icons": {
      "types": "./icons.d.ts",
      "default": "./icons.js"
    },
    "./programs": {
      "types": "./programs.d.ts",
      "default": "./programs.js"
    }
  }
}
